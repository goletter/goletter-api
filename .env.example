APP_NAME=skeleton
APP_ENV=dev
SERVER_PORT=

# 日志目录（为空则使用 runtime/logs），保留天数（0 表示不清理）
LOG_PATH=
LOG_MAX_FILES=30

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# 接口限流（RateLimitMiddleware 已挂在全局 HTTP 中间件，enable=false 时直接放行）
RATE_LIMIT_ENABLE=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60
RATE_LIMIT_DIMENSION=ip
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_USE_FORWARDED=false

REDIS_HOST=localhost
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0

MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Goletter

AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=guest
AMQP_PASSWORD=guest
AMQP_VHOST=/
