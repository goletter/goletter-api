APP_NAME=skeleton
APP_ENV=dev
SERVER_PORT=

# 日志目录（为空则使用 runtime/logs），按分类分子目录；保留天数；级别 DEBUG|INFO|WARNING|ERROR...
LOG_PATH=
LOG_MAX_FILES=30
LOG_LEVEL=DEBUG

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# 接口限流（RateLimitMiddleware 已挂在全局 HTTP 中间件，enable=false 时直接放行）
RATE_LIMIT_ENABLE=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60
RATE_LIMIT_DIMENSION=ip
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_USE_FORWARDED=false

REDIS_HOST=localhost
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=0

MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PORT=587
MAIL_SMTP_ENCRYPTION=tls
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Goletter

AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=guest
AMQP_PASSWORD=guest
AMQP_VHOST=/
AMQP_POOL_CONNECTIONS=32
AMQP_CONNECTION_TIMEOUT=10
AMQP_READ_WRITE_TIMEOUT=60
AMQP_HEARTBEAT=30

# 子模块 -> 平台鉴权（PlatformAuthMiddleware）
PLATFORM_AUTH_ENABLE=true
PLATFORM_MODULE=goletter-api
PLATFORM_BASE_URI=https://platform.example.com
PLATFORM_VERIFY_PATH=/internal/auth/verify
PLATFORM_WEBHOOK_CONFIG_PATH=/internal/webhook/config
PLATFORM_APP_ID=
PLATFORM_APP_SECRET=
PLATFORM_HTTP_TIMEOUT=3
PLATFORM_HTTP_CONNECT_TIMEOUT=1
PLATFORM_AUTH_CACHE_TTL=60

# 出站 Webhook（租户配置在平台；无平台配置时用全局）
WEBHOOK_ENABLE=false
WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_HEADER=X-Goletter-Signature
WEBHOOK_DEFAULT_URL=
WEBHOOK_ACCOUNT_DEMAND_SUCCEEDED_URL=
WEBHOOK_ACCOUNT_DEMAND_FAILED_URL=
WEBHOOK_HTTP_TIMEOUT=5
WEBHOOK_HTTP_CONNECT_TIMEOUT=2
WEBHOOK_TENANT_CACHE_TTL=60
# 失败重推间隔（毫秒）；平台返回的 retry_delay_ms 优先
WEBHOOK_RETRY_DELAY_MS=3000
WEBHOOK_MAX_ATTEMPTS=5
