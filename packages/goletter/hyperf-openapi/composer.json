{
    "name": "goletter/hyperf-openapi",
    "description": "Hyperf OpenAPI 3：自动扫描分发 Controller 生成文档，可直接导入 Apifox（无需注解）。",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "goletter",
            "email": "goletter@outlook.com"
        }
    ],
    "keywords": [
        "php",
        "hyperf",
        "openapi",
        "apifox",
        "swagger",
        "goletter"
    ],
    "require": {
        "php": ">=8.1",
        "hyperf/command": "~3.1.0",
        "hyperf/context": "~3.1.0",
        "hyperf/contract": "~3.1.0",
        "hyperf/http-server": "~3.1.0"
    },
    "suggest": {
        "symfony/yaml": "生成 openapi.yaml 时需要（^6|^7）。",
        "hyperf/validation": "从 FormRequest::rules() 推断 requestBody 时需要。",
        "hyperf/database": "识别 Model 路由参数 {id} 时需要。",
        "hyperf/framework": "使用 ConfigProvider / DI / Listener 时需要。"
    },
    "autoload": {
        "psr-4": {
            "Goletter\\OpenApi\\": "src/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Goletter\\OpenApi\\ConfigProvider"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
