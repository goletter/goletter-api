{
    "name": "goletter/hyperf-akm",
    "description": "蓝瀚媒体代理业务 OpenAPI。Token 轮询与公共异常复用",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "goletter",
            "email": "goletter@outlook.com"
        }
    ],
    "keywords": [
        "php",
        "hyperf",
        "ads",
        "akms"
    ],
    "require": {
        "php": ">=8.1",
        "goletter/hyperf-adv": "^1.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "suggest": {
        "hyperf/framework": "Required to use ConfigProvider in Hyperf applications."
    },
    "autoload": {
        "psr-4": {
            "Goletter\\Akm\\": "src/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Goletter\\Akm\\ConfigProvider"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
