{
  "name": "goletter/hyperf-mtls",
  "description": "Hyperf mTLS certificate generator",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "goletter",
      "email": "goletter@outlook.com"
    }
  ],
  "keywords": [
    "php",
    "hyperf",
    "mtls",
    "openssl",
    "certificate"
  ],
  "require": {
    "php": ">=8.1",
    "ext-openssl": "*",
    "hyperf/command": "~3.1.0",
    "hyperf/config": "~3.1.0",
    "hyperf/contract": "~3.1.0",
    "hyperf/di": "~3.1.0"
  },
  "autoload": {
    "psr-4": {
      "Goletter\\Mtls\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "3.1-dev"
    },
    "hyperf": {
      "config": "Goletter\\Mtls\\ConfigProvider"
    }
  }
}
